# Database
DB_URL=jdbc:postgresql://localhost:5432/operatorsJSON_DB
DB_USERNAME=postgres
DB_PASSWORD=replace_me
HIBERNATE_DDL_AUTO=update
PORT=8686

# Application authentication
# Use long random values for real deployments.
PASSWORD_HMAC_KEY=replace_with_a_long_random_secret
BOOTSTRAP_ADMIN_USERNAME=SuperAdmin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password

# Optional temporary/default passwords used by the legacy password-reset flow.
# Configure only the levels that need reset support.
RESET_PASSWORD_LEVEL_0=replace_me
RESET_PASSWORD_LEVEL_1=replace_me
RESET_PASSWORD_LEVEL_2=replace_me

# Optional outbound HTTP proxy, including credentials only in your local environment.
# OUTBOUND_PROXY_URL=http://user:password@proxy.example.com:8080

# Optional external IP checker endpoint used by /logincontroller/ipcheck.
# IP_CHECK_URL=https://example.com/ip-check
